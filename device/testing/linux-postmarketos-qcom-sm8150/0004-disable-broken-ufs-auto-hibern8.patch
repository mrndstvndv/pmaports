--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -1127,6 +1127,9 @@ static void ufs_qcom_advertise_quirks(struct ufs_hba *hba)
 	if (host->hw_ver.major > 0x3)
 		hba->quirks |= UFSHCD_QUIRK_REINIT_AFTER_MAX_GEAR_SWITCH;
 
+	/* SM8150 UFS controller has broken hardware auto-hibern8 under heavy burst I/O */
+	hba->quirks |= UFSHCD_QUIRK_BROKEN_AUTO_HIBERN8;
+
 	if (drvdata && drvdata->quirks)
 		hba->quirks |= drvdata->quirks;
 }
@@ -1504,7 +1507,8 @@ static int ufs_qcom_fw_managed_init(struct ufs_hba *hba)
 	ufs_qcom_advertise_quirks(hba);
 	host->hba->quirks &= ~UFSHCD_QUIRK_REINIT_AFTER_MAX_GEAR_SWITCH;
 
-	hba->spm_lvl = hba->rpm_lvl = hba->pm_lvl_min = UFS_PM_LVL_5;
+	hba->spm_lvl = hba->pm_lvl_min = UFS_PM_LVL_5;
+	hba->rpm_lvl = UFS_PM_LVL_0;
 
 	ufs_qcom_set_host_params(hba);
 	ufs_qcom_parse_gear_limits(hba);
