+					      msecs_to_jiffies(1000));
+			return NOTIFY_OK;
+		}
 
 		chip->status = propval.intval;
 
@@ -1171,6 +1189,7 @@ static int qcom_fg_probe(struct platform_device *pdev)
 
 	chip->dev = &pdev->dev;
 	chip->ops = of_device_get_match_data(&pdev->dev);
+	chip->status = POWER_SUPPLY_STATUS_UNKNOWN;
 
