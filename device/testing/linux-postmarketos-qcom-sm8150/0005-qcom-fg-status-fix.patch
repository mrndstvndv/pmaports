 	if (!chip->regmap) {
@@ -1330,11 +1349,23 @@ static int qcom_fg_probe(struct platform_device *pdev)
 						    "power-supplies");
 	if (IS_ERR(chip->chg_psy)) {
 		ret = PTR_ERR(chip->chg_psy);
