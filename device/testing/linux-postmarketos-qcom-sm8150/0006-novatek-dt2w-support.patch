+	valid_interval =
+		time_after_eq(now, last_tap_jiffies + msecs_to_jiffies(100)) &&
+		time_before_eq(now, last_tap_jiffies + msecs_to_jiffies(700));
+	nearby = abs((int32_t)input_x - (int32_t)last_tap_x) <= 200 &&
+		abs((int32_t)input_y - (int32_t)last_tap_y) <= 200;
+
+	if (!last_tap_jiffies || !valid_interval || !nearby) {
+		last_tap_jiffies = now;
+		last_tap_x = input_x;
+		last_tap_y = input_y;
+		return;
+	}
+
+	last_tap_jiffies = 0;
+	NVT_LOG("Software gesture: Double Tap\n");
+	pm_wakeup_event(&ts->client->dev, 5000);
+	input_report_key(ts->input_dev, KEY_WAKEUP, 1);
+	input_sync(ts->input_dev);
+	input_report_key(ts->input_dev, KEY_WAKEUP, 0);
+	input_sync(ts->input_dev);
+}
