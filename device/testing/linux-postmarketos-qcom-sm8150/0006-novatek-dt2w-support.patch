+static void nvt_ts_software_double_tap_report(uint8_t *point_data)
+{
+	uint32_t input_x = 0;
+	uint32_t input_y = 0;
+	bool touch_active = false;
+	unsigned long now;
+	bool valid_interval;
+	bool nearby;
+	int i;
+
+	for (i = 0; i < ts->max_touch_num; i++) {
+		const int position = 1 + 6 * i;
+		const uint8_t touch_state = point_data[position] & 0x07;
+		const uint8_t input_id = point_data[position] >> 3;
+
+		if (!input_id || input_id > ts->max_touch_num)
+			continue;
+		if (touch_state != 0x01 && touch_state != 0x02)
+			continue;
+
+		input_x = (point_data[position + 1] << 4) |
+			(point_data[position + 3] >> 4);
+		input_y = (point_data[position + 2] << 4) |
+			(point_data[position + 3] & 0x0F);
+		touch_active = true;
+		break;
+	}
+
+	if (!touch_active) {
+		offscreen_touch_active = false;
+		return;
+	}
+	if (offscreen_touch_active)
+		return;
+
+	offscreen_touch_active = true;
