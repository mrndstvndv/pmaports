# Contributor: Steven <steven@example.com>
# Maintainer: Steven <steven@example.com>
pkgname=hyprtoolkit
pkgver=0.5.4
pkgrel=1
pkgdesc="A modern C++ Wayland-native GUI toolkit"
url="https://github.com/hyprwm/hyprtoolkit"
arch="all"
license="BSD-3-Clause"
source="https://github.com/hyprwm/hyprtoolkit/archive/v$pkgver/hyprtoolkit-v$pkgver.tar.gz"
builddir="$srcdir/hyprtoolkit-$pkgver"
makedepends="
 cmake
 samurai
 hyprwayland-scanner
 wayland-dev
 wayland-protocols
 mesa-dev
 hyprutils-dev
 hyprlang-dev
 pixman-dev
 libdrm-dev
 libxkbcommon-dev
 pango-dev
 cairo-dev
 iniparser-dev
 hyprgraphics-dev
 aquamarine-dev
"
subpackages="$pkgname-dev"
options="!check"

prepare() {
 default_prepare
 sed -i "s/OpenGL::OpenGL/OpenGL::GLES3/" CMakeLists.txt
}

build() {
 cmake -B build -G Ninja \
   -DCMAKE_BUILD_TYPE=Release \
   -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib
 ninja -C build
}

package() {
 DESTDIR="$pkgdir" ninja -C build install
}
sha512sums="
