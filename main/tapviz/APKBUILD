# Contributor: Steven <steven@example.com>
# Maintainer: Steven <steven@example.com>
pkgname=tapviz
pkgver=0.1.0
pkgrel=1
pkgdesc="Android-like touchscreen tap visualizer for Hyprland"
url="https://github.com/mrndstvndv/tapviz"
arch="aarch64"
license="unknown"
depends="hyprland=0.56.2-r0"
# Deterministic git archive of tapviz commit.
_commit=651fcc37cec89e87e0fb5085d129de89dcadab1e
source="tapviz-$pkgver.tar.gz::https://github.com/mrndstvndv/tapviz/archive/$_commit/tapviz-$_commit.tar.gz"
builddir="$srcdir/tapviz-$_commit"
makedepends="
 cairo-dev
 cmake
 eudev-dev
 glslang-dev
 hyprland-dev=0.56.2-r0
 libdrm-dev
 libinput-dev
 libxkbcommon-dev
 lua5.5-dev
 mesa-dev
 pango-dev
 pixman-dev
 pkgconf
 samurai
 wayland-dev
"
options="!check"

build() {
 cmake -B build -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr \
  -DCMAKE_INSTALL_LIBDIR=lib
 cmake --build build
}

package() {
 DESTDIR="$pkgdir" cmake --install build
 install -d "$pkgdir"/usr/lib/hyprland/plugins
 mv "$pkgdir"/usr/lib/libtapviz.so "$pkgdir"/usr/lib/hyprland/plugins/tapviz.so
}

sha512sums="
84ebf90a3b6b5ada4c852d3899524458a22e1fcaf7c4643aac793ae12260046ac85fd772f59a9fa6b0b3663742b91b6372ebc4fa3578ee1a7d1d2acd784bab67  tapviz-0.1.0.tar.gz
"
